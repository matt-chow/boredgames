{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boredgames",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true },
  "env": {
    // An isolated Worker with its own Durable Object namespace, so no room or session is shared with production.
    "staging": {
      "name": "boredgames-staging",
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
      "observability": { "enabled": true },
      // Lets hosts here pick trial rules. Never set this for production.
      "vars": { "EXPERIMENTS": "on" }
    }
  }
}
